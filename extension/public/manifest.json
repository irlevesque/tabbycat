{
  "manifest_version": 3,
  "name": "Tabbycat",
  "version": "1.0.0",
  "description": "Sync tabs and tab groups across multiple browsers",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabbycat"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
